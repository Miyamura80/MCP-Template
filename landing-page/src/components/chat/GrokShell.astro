---
/*
 * Grok (xAI) chat shell - near-black canvas, centered wordmark top bar, muted
 * grey rounded user bubble, bubble-less assistant text, a compact pill for the
 * tool call, and the large rounded "Ask anything" composer with a round white
 * send button. Monochrome on purpose: Grok's UI has no accent colour.
 * Card stays cyan.
 */
import ConvoScroll from "./ConvoScroll.astro";
---

<div class="overflow-hidden rounded-xl border border-[#2a2a2a] bg-[#0f0f0f] text-[#e7e7e7] shadow-2xl shadow-black/50">
  <!-- top bar: grokbot glyph + wordmark -->
  <div class="flex items-center justify-center gap-2 border-b border-[#1f1f1f] px-3 py-2.5 sm:px-4">
    <span class="size-4 bg-[#e7e7e7]" style="-webkit-mask:url('/logos/grokbot.svg') center/contain no-repeat;mask:url('/logos/grokbot.svg') center/contain no-repeat" aria-hidden="true"></span>
    <span class="text-sm font-semibold tracking-tight text-[#e7e7e7]">Grok</span>
  </div>

  <div class="space-y-3.5 px-3 pb-2 pt-3.5 sm:px-4">
    <!-- user bubble (right) -->
    <div class="flex justify-end">
      <p class="max-w-[85%] rounded-3xl bg-[#262626] px-4 py-2.5 text-sm text-[#f2f2f2]">
        Triage my inbox and draft replies.
      </p>
    </div>

    <!-- assistant: plain text, tool pill -->
    <div class="space-y-2.5">
      <p class="text-sm leading-relaxed text-[#e7e7e7]">Pulling your inbox with the connected tool.</p>

      <div class="inline-flex items-center gap-2 rounded-full border border-[#2a2a2a] bg-[#171717] px-3 py-1">
        <svg class="size-3.5 text-[#a3a3a3]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
        <span class="font-mono text-xs text-[#d4d4d4]">gmail_curate_inbox</span>
        <svg class="size-3 text-[#a3a3a3]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
      </div>

      <ConvoScroll>
        <!-- summoned host-chat turn: the app posted this user message -->
        <div class="flex justify-end">
          <p class="max-w-[85%] rounded-3xl bg-[#262626] px-4 py-2.5 text-sm text-[#f2f2f2]">
            Draft a researched reply to the Q3 contract thread from Dana.
          </p>
        </div>
        <div class="space-y-2">
          <div class="inline-flex items-center gap-2 rounded-full border border-[#2a2a2a] bg-[#171717] px-3 py-1">
            <svg class="size-3.5 text-[#a3a3a3]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
            <span class="font-mono text-xs text-[#d4d4d4]">gmail_reply_to_thread</span>
            <svg class="size-3 text-[#a3a3a3]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
          </div>
          <p class="text-sm leading-relaxed text-[#e7e7e7]">Researched the thread and drafted a reply, saved to your inbox.</p>
        </div>
      </ConvoScroll>
    </div>
  </div>

  <!-- composer -->
  <div class="px-3 pb-4 pt-1 sm:px-4">
    <div class="flex items-center gap-2 rounded-3xl border border-[#2a2a2a] bg-[#171717] py-2 pl-4 pr-2">
      <span class="min-w-0 flex-1 truncate text-sm text-[#8a8a8a]">Ask anything</span>
      <span class="hidden rounded-full border border-[#2a2a2a] px-2.5 py-1 text-[11px] text-[#a3a3a3] sm:inline">Auto</span>
      <span class="grid size-8 place-items-center rounded-full bg-[#f2f2f2] text-[#0f0f0f]">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"></path></svg>
      </span>
    </div>
  </div>
</div>
